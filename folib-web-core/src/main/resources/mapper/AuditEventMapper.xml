<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.veadan.folib.mapper.AuditEventMapper">

    <resultMap id="auditEventMap" type="com.veadan.folib.entity.AuditEvent">
        <id property="id" column="id"/>
        <result property="moduleName" column="module_name"/>
        <result property="moduleValue" column="module_value"/>
    </resultMap>


    <!-- 批量更新操作 -->
    <update id="updateById">
            UPDATE audit_event
            SET
            used = #{used}
            WHERE id = #{id}
    </update>

    <select id="findAllModule" resultMap="auditEventMap">
        select module_value,module_name from audit_event
        group by module_value,module_name;
    </select>


</mapper>