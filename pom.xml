<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>
<!---Dfolib.db.profile=db_REMOTE-->
    <parent>
        <groupId>com.veadan.folib</groupId>
        <artifactId>folib-parent</artifactId>
        <version>3.0-SNAPSHOT</version>
        <relativePath/>
    </parent>

    <artifactId>folib-server</artifactId>
    <packaging>pom</packaging>
    <name>Folib: Server</name>
    <inceptionYear>2019</inceptionYear>

     <scm>
        <url>http://git.folib.com/folib/folib-server</url>
        <connection>scm:git:git://git.folib.com/folib/folib-server.git</connection>
        <developerConnection>scm:git:git://git.folib.com/folib/folib-server.git</developerConnection>
    </scm>

    <licenses>
        <license>
             <name>Mulan Public License, Version 2</name>
             <url>https://license.coscl.org.cn/MulanPubL-2.0</url>
            <distribution>repo</distribution>
            <comments>Mulan PubL v2 is a copyleft license with terms on code disclosure and attribution. Approved by OSI.</comments>
        </license>
    </licenses>


    <modules>
        <module>folib-commons</module>
        <module>folib-configuration</module>
        <module>folib-event-api</module>
        <module>folib-security</module>
        <module>folib-api</module>
        <module>folib-job</module>
        <module>folib-storage</module>
        <module>folib-gremlin-service</module>
        <module>folib-web-dto</module>
        <module>folib-web-core</module>
        <module>folib-build</module>
        <module>folib-web-vue</module>
        <module>folib-core</module>
        <module>folib-docs</module>
    </modules>

    <profiles>
        <profile>
            <id>dependency-check</id>

            <activation>
                <activeByDefault>false</activeByDefault>
            </activation>

            <build>
                <plugins>
                    <plugin>
                        <groupId>org.owasp</groupId>
                        <artifactId>dependency-check-maven</artifactId>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <profile>
            <id>checkstyle</id>

            <activation>
                <activeByDefault>false</activeByDefault>
            </activation>

            <build>
                <pluginManagement>
                    <plugins>
                        <plugin>
                            <groupId>com.mycila</groupId>
                            <artifactId>license-maven-plugin</artifactId>
                            <version>5.0.0</version>
                            <configuration>
                                <header>${project.basedir}/license-header.txt</header>
                                <includes>
                                    <include>**/*.java</include>
                                </includes>
                                <mapping>
                                    <java>SLASHSTAR_STYLE</java>
                                </mapping>
                            </configuration>
                            <executions>
                                <execution>
                                    <goals>
                                        <goal>format</goal>
                                    </goals>
                                </execution>
                            </executions>
                        </plugin>
                    </plugins>
                </pluginManagement>
            </build>
        </profile>
    </profiles>
</project>
