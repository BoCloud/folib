<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.veadan.folib.mapper.FolibRoleMapper">
    <resultMap type="com.veadan.folib.entity.FolibRole" id="FolibRoleMap">
        <result property="id" column="id" jdbcType="String"/>
        <result property="cnName" column="cn_name" jdbcType="String"/>
        <result property="enName" column="en_name" jdbcType="String"/>
        <result property="description" column="description" jdbcType="String"/>
        <result property="deleted" column="deleted" jdbcType="String"/>
        <result property="isdefault" column="isDefault" jdbcType="String"/>
        <result property="createBy" column="create_by" jdbcType="String"/>
        <result property="createTime" column="create_time" jdbcType="timestamp"/>
        <result property="updateBy" column="update_by" jdbcType="String"/>
        <result property="updateTime" column="update_time" jdbcType="timestamp"/>
    </resultMap>

    <!-- 通过ID查询单条数据 -->
    <select id="queryById" resultMap="FolibRoleMap">
        select
            id,cn_name,en_name,description,deleted,isDefault,create_by,create_time,update_by,update_time
        from folib_role
        where id = #{id}
    </select>

    <!--分页查询指定行数据-->
    <select id="queryAllByLimit" resultMap="FolibRoleMap">
        select
        id,cn_name,en_name,description,deleted,isDefault,create_by,create_time,update_by,update_time
        from folib_role
        <where>
            <if test="id != null and id != ''">
                and id = #{id}
            </if>
            <if test="cnName != null and cnName != ''">
                and cn_name = #{cnName}
            </if>
            <if test="enName != null and enName != ''">
                and en_name = #{enName}
            </if>
            <if test="description != null and description != ''">
                and description = #{description}
            </if>
            <if test="deleted != null and deleted != ''">
                and deleted = #{deleted}
            </if>
            <if test="isdefault != null and isdefault != ''">
                and isDefault = #{isdefault}
            </if>
            <if test="createBy != null and createBy != ''">
                and create_by = #{createBy}
            </if>
            <if test="createTime != null and createTime != ''">
                and create_time = #{createTime}
            </if>
            <if test="updateBy != null and updateBy != ''">
                and update_by = #{updateBy}
            </if>
            <if test="updateTime != null and updateTime != ''">
                and update_time = #{updateTime}
            </if>
        </where>
        limit #{pageable.offset}, #{pageable.pageSize}
    </select>

    <!--统计总行数-->
    <select id="count" resultType="java.lang.Long">
        select count(1)
        from folib_role
        <where>
            <if test="id != null and id != ''">
                and id = #{id}
            </if>
            <if test="cnName != null and cnName != ''">
                and cn_name = #{cnName}
            </if>
            <if test="enName != null and enName != ''">
                and en_name = #{enName}
            </if>
            <if test="description != null and description != ''">
                and description = #{description}
            </if>
            <if test="deleted != null and deleted != ''">
                and deleted = #{deleted}
            </if>
            <if test="isdefault != null and isdefault != ''">
                and isDefault = #{isdefault}
            </if>
            <if test="createBy != null and createBy != ''">
                and create_by = #{createBy}
            </if>
            <if test="createTime != null and createTime != ''">
                and create_time = #{createTime}
            </if>
            <if test="updateBy != null and updateBy != ''">
                and update_by = #{updateBy}
            </if>
            <if test="updateTime != null and updateTime != ''">
                and update_time = #{updateTime}
            </if>
        </where>
    </select>

    <!--新增数据-->
    <insert id="insert" keyProperty="id" useGeneratedKeys="true">
        insert into folib_role(id,cn_name,en_name,description,deleted,isDefault,create_by,create_time,update_by,update_time)
        values (#{id},#{cnName},#{enName},#{description},#{deleted},#{isdefault},#{createBy},#{createTime},#{updateBy},#{updateTime})
    </insert>

    <!-- 批量新增数据 -->
    <insert id="insertBatch" keyProperty="id" useGeneratedKeys="true">
        insert into folib_role(id,cn_name,en_name,description,deleted,isDefault,create_by,create_time,update_by,update_time)
        values
        <foreach collection="entities" item="entity" separator=",">
            (#{entity.id},#{entity.cnName},#{entity.enName},#{entity.description},#{entity.deleted},#{entity.isdefault},#{entity.createBy},#{entity.createTime},#{entity.updateBy},#{entity.updateTime})
        </foreach>
    </insert>

    <!-- 批量新增或按主键更新数据 -->
    <insert id="insertOrUpdateBatch" keyProperty="id" useGeneratedKeys="true">
        insert into folib_role(id,cn_name,en_name,description,deleted,isDefault,create_by,create_time,update_by,update_time)
        values
        <foreach collection="entities" item="entity" separator=",">
            (#{entity.id},#{entity.cnName},#{entity.enName},#{entity.description},#{entity.deleted},#{entity.isdefault},#{entity.createBy},#{entity.createTime},#{entity.updateBy},#{entity.updateTime})
        </foreach>
        on duplicate key update
        id=values(id),
        cn_name=values(cn_name),
        en_name=values(en_name),
        description=values(description),
        deleted=values(deleted),
        isDefault=values(isDefault),
        create_by=values(create_by),
        create_time=values(create_time),
        update_by=values(update_by),
        update_time=values(update_time)
    </insert>

    <!-- 更新数据 -->
    <update id="update">
        update folib_role
        <set>
            <if test="id != null and id != ''">
                id = #{id},
            </if>
            <if test="cnName != null and cnName != ''">
                cn_name = #{cnName},
            </if>
            <if test="enName != null and enName != ''">
                en_name = #{enName},
            </if>
            <if test="description != null and description != ''">
                description = #{description},
            </if>
            <if test="deleted != null and deleted != ''">
                deleted = #{deleted},
            </if>
            <if test="isdefault != null and isdefault != ''">
                isDefault = #{isdefault},
            </if>
            <if test="createBy != null and createBy != ''">
                create_by = #{createBy},
            </if>
            <if test="createTime != null and createTime != ''">
                create_time = #{createTime},
            </if>
            <if test="updateBy != null and updateBy != ''">
                update_by = #{updateBy},
            </if>
            <if test="updateTime != null and updateTime != ''">
                update_time = #{updateTime},
            </if>
        </set>
        where id = #{id}
    </update>

    <!--通过主键删除-->
    <delete id="deleteById">
        delete from folib_role where id = #{id}
    </delete>
</mapper>