    <mirrors>
        <mirror>
            <id>folib-group-maven</id>
            <name>folib-group-maven</name>
            <url>http://58.210.154.140:2477/storages/folib-common/folib-group-maven</url>
            <mirrorOf>central</mirrorOf>
        </mirror>

        <mirror>
            <id>folib-local-maven</id>
