            </activation>
            <properties>
                <maven.compiler.source>11</maven.compiler.source>
                <maven.compiler.target>11</maven.compiler.target>
                <maven.compiler.compilerVersion>11</maven.compiler.compilerVersion>
            </properties>
        </profile>

        <profile>
            <id>folib-local-maven</id>
            <repositories>
                <repository>
                    <id>central</id>
                    <url>http://58.210.154.140:2477/storages/folib-common/folib-local-maven</url>
                    <snapshots>
                        <enabled>true</enabled>
                    </snapshots>
                </repository>
            </repositories>
        </profile>

    </profiles>

    <activeProfiles>
        <activeProfile>folib-local-maven</activeProfile>
        <activeProfile>jdk-11</activeProfile>

    </activeProfiles>


