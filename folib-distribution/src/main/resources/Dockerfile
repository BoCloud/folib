WORKDIR  ${RUN_WORKDIR}
VOLUME  ${RUN_WORKDIR}/folib-vault/
EXPOSE ${FOLIB_PORT}
EXPOSE 7010
EXPOSE 7011
EXPOSE ${FOLIB_JMX_PORT}
EXPOSE 49142
EXPOSE 8182
ENTRYPOINT exec ${RUN_WORKDIR}/folib-1.0-SNAPSHOT/bin/folib console
