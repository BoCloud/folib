ENV FOLIB_PROMOTION_WS_REQUEST_TIMOUT_OF_ARTIFACT_UPLOAD="${FOLIB_PROMOTION_WS_REQUEST_TIMOUT_OF_ARTIFACT_UPLOAD:-600}"
ENV FOLIB_PROMOTION_QUEUE_SIZE="${FOLIB_PROMOTION_QUEUE_SIZE:-1000}"
